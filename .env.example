# Copy to .env and chmod 600 .env. These placeholders intentionally cannot start the gateway.
# Generate two different values with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
GATEWAY_API_TOKEN=replace_with_a_random_gateway_token_at_least_32_characters
GOTIFY_ADMIN_USER=admin
GOTIFY_ADMIN_PASSWORD=replace_with_a_different_random_admin_password

# Create an application as the receiving Gotify user, then copy its application token here.
# Never use an Android client token, gateway API token, or admin password here.
GOTIFY_APP_TOKEN=replace_with_the_gotify_application_token
GOTIFY_URL=http://gotify:80
GOTIFY_TIMEOUT_SECONDS=5
MAX_REQUEST_BYTES=65536

# Bind explicitly to host loopback; other containers use the Docker service name.
GATEWAY_PORT=8090
GOTIFY_PORT=8080
TZ=Asia/Shanghai

# true for the public HTTPS domain. HTTP-only bootstrap may require false temporarily.
GOTIFY_SECURE_COOKIE=true

# Enable only after creating cloudflared/config.yml and the tunnel credential file.
# Runtime credentials are kept in .secrets/, never in Git.
COMPOSE_PROFILES=

# Optional NapCat watcher (needs an existing NapCat Docker network).
# Enable by adding: COMPOSE_FILE=docker-compose.yml:docker-compose.napcat.yml
NAPCAT_LINK_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
# Public HTTPS domain used by Gotify & NapCat QR login (replace with your actual domain)
NAPCAT_PUBLIC_URL=https://gotify.example.com
NAPCAT_NETWORK=astrbot_default
NAPCAT_URL=http://napcat:6099
NAPCAT_POLL_SECONDS=15
NAPCAT_OFFLINE_SECONDS=60
NAPCAT_RECOVERY_SECONDS=30
NAPCAT_REMINDER_SECONDS=1800
NAPCAT_LINK_TTL_SECONDS=3600
